# --- core ---
JWT_SECRET_KEY=changeme_generate_locally
DATABASE_URL=sqlite:///backend/db/simswap.db

# --- auth / demo users (created by `python -m backend.db.seed`) ---
# analyst / demo123  (analyst)   system-wide analytics
# sim-customer / demo123 (customer)  demo traffic account
# admin / demo123 (admin)   system-wide analytics + user management

# --- demo traffic (autonomous event generator on the deployed app) ---
# Must be explicitly enabled; defaults keep production quiet.
ENABLE_DEMO_TRAFFIC=false
DEMO_TRAFFIC_INTERVAL=5
DEMO_TRAFFIC_RATE=1

# --- notifications (optional; logs to console when unset) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=